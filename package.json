{
  "name": "permesso-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "fonts:build": "node --import tsx scripts/build-font.ts",
    "predev": "npm run fonts:build",
    "prebuild": "npm run fonts:build",
    "pretest": "npm run fonts:build",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node --import tsx scripts/verify-dist.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "demo:pdf": "tsx scripts/render-demo.ts",
    "demo:additional": "tsx scripts/render-additional.ts",
    "demo:p1": "tsx scripts/render-p1.ts",
    "test:browser": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "check:all": "npm run check && npm run test:browser",
    "test:production": "playwright test --config playwright.production.config.ts",
    "rules:build": "node --import tsx scripts/build-field-rules.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "harfbuzzjs": "^1.6.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only"
}
